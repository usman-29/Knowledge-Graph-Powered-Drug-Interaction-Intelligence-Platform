# ──────────────────────────────────────────────────────────────────────────────
#  Server configuration template.
#  Copy to `.env` and fill in real values:  cp .env.example .env
#  NEVER commit the real .env — it is git-ignored.
# ──────────────────────────────────────────────────────────────────────────────

# ── Neo4j (local Docker — see docker-compose.yml) ─────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# ── Neo4j Aura (cloud) — uncomment to switch to a managed instance ────────────
# NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
# NEO4J_USER=<your-user>
# NEO4J_PASSWORD=<your-password>
# NEO4J_DATABASE=<your-database>

# ── openFDA — optional, raises the public rate limit ──────────────────────────
# Get a free key at https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── LLM access (HuggingFace) ──────────────────────────────────────────────────
# Token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# ── Lobster Trap proxy — all LLM traffic routes through this DPI proxy ─────────
VEEA_ENDPOINT=http://localhost:8080/v1
LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# ── Clinical fact-checking (optional second-opinion verifier) ─────────────────
ENABLE_CLINICAL_VERIFICATION=true
VERIFIER_MODEL_ID=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
VERIFIER_API_URL=https://router.huggingface.co/v1/chat/completions

# ── Persistence paths (defaults are fine for local dev) ───────────────────────
# CHECKPOINT_DB=data/checkpoints.sqlite
# AUDIT_LOG_DIR=data/audit_logs
# PATIENTS_FILE=data/patients.json
# USERS_DB=data/users.sqlite
